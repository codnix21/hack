# Скопируйте в .env на сервере и поправьте значения:
#   cp .env.example .env
#
# ENVIRONMENT=demo — локальная/хакатон-демонстрация (допустимы seed-пароли из README).
# ENVIRONMENT=production — обязателен уникальный SECRET_KEY ≥ 32 символов;
#   иначе backend откажется запускаться.

ENVIRONMENT=demo

POSTGRES_USER=robot
POSTGRES_PASSWORD=замените_сложный_пароль
POSTGRES_DB=robot_platform
# POSTGRES_PORT=127.0.0.1:5435

SECRET_KEY=замените_длинный_секрет_не_короче_32_символов
CORS_ORIGINS=https://bas.netcorehub.ru,https://www.bas.netcorehub.ru

# Порты по умолчанию привязаны к 127.0.0.1 (не вся сеть)
FRONTEND_PORT=127.0.0.1:8910
# BACKEND_PORT=127.0.0.1:8010

VITE_API_URL=/api
